# Policy Navigator local environment example
# Replace placeholders with local values only. Do not commit real secrets.

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ollama Cloud
OLLAMA_CLOUD_BASE_URL=https://your-ollama-cloud-endpoint
OLLAMA_TIMEOUT_MS=15000

# HF Spaces
HF_SPACES_DOCLING_URL=https://your-docling-space.example
HF_SPACES_KEEPWARM_URL=https://your-keepwarm-endpoint.example

# Municode
MUNICODE_BASE_URL=https://api.municode.com
MUNICODE_CLIENT_ID=10051
MUNICODE_USER_AGENT=Policy Navigator <your-email-or-app-id>

# Retrieval tuning
RRF_K_CONSTANT=60
RETRIEVAL_CANDIDATE_COUNT=40
RETRIEVAL_CONTEXT_COUNT=8
INCOMPLETE_SEARCH_FLOOR=0.0

# Vercel
VERCEL_DEPLOY_TOKEN=your-vercel-deploy-token

# Shared admin gate
# Used by both the /admin frontend route and the acknowledge-alert Edge Function.
ADMIN_SECRET=your-admin-secret
