# Policy Navigator local environment example
# Replace placeholders with local values only. Do not commit real secrets.

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Ollama Cloud
OLLAMA_CLOUD_BASE_URL=https://your-ollama-cloud-endpoint
# Preferred Supabase Edge Function secret for Ollama Cloud auth.
OLLAMA_API_KEY=your-ollama-api-key
OLLAMA_TIMEOUT_MS=15000

# HF Spaces
HF_SPACES_DOCLING_URL=https://danielleag30-policy-navigator-docling.hf.space
HF_SPACES_KEEPWARM_URL=https://danielleag30-policy-navigator-docling.hf.space/health

# Municode
MUNICODE_BASE_URL=https://api.municode.com
MUNICODE_CLIENT_ID=10051
MUNICODE_USER_AGENT=Policy Navigator <your-email-or-app-id>

# Retrieval tuning
RRF_K_CONSTANT=60
RETRIEVAL_CANDIDATE_COUNT=40
RETRIEVAL_CONTEXT_COUNT=8
INCOMPLETE_SEARCH_FLOOR=0.0

# EnCode zoning archive (robots.txt-disallowed /regs/ path -- requires human/legal
# sign-off before setting to "true"). Shared by the recurring current-tree crawler
# (ingest-orchestrator/encode.ts), the deep-historical live-lookup slow path
# (query-pipeline/_deep-historical.ts), and the resumable OCR pre-ingestion job
# (encode-reprint-preingest).
ENCODE_ZONING_ENABLED=false
ENCODE_BASE_URL=https://online.encodeplus.com/regs/fairfaxcounty-va
ENCODE_USER_AGENT=Policy Navigator <your-email-or-app-id>

# Deep-historical slow path (query-pipeline/_deep-historical.ts) -- extended
# timeouts for this one path's live-OCR fallback only; do not change
# OLLAMA_TIMEOUT_MS above. The fast path (pre-ingested store) has no timeout.
DEEP_HISTORICAL_DOCLING_TIMEOUT_MS=110000
DEEP_HISTORICAL_LLM_TIMEOUT_MS=20000

# Vercel
VERCEL_DEPLOY_TOKEN=your-vercel-deploy-token

# Shared admin gate
# Used by both the /admin frontend route and the acknowledge-alert Edge Function.
ADMIN_SECRET=your-admin-secret
